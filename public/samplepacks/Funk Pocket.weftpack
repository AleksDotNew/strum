{"weftpack":1,"id":"funk","name":"Funk Pocket","by":"Weft Loom","about":"Funk at 104: a tight kick and snare, hats, a tambourine, a clav, a slapped bass and a horn stab, and presets to play each. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"funk_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"funk_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"funk_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"funk_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"funk_tambourine","file":"tambourine.wav","type":"audio/wav","seconds":0.35,"data":""},{"name":"funk_clav","file":"clav.wav","type":"audio/wav","seconds":0.3,"data":""},{"name":"funk_slap","file":"slap.wav","type":"audio/wav","seconds":0.9,"data":""},{"name":"funk_horns","file":"horns.wav","type":"audio/wav","seconds":0.9,"data":""}],"presets":[{"name":"Funk slap","calls":[".s(\"gm_slap_bass_1\")",".decay(slider(0.4, 0, 2))",".sustain(slider(0.3, 0, 1))"],"pitch":40},{"name":"Funk clav","calls":[".s(\"gm_clavinet\")",".decay(slider(0.2, 0, 2))",".sustain(slider(0.2, 0, 1))",".phaser(slider(0.5, 0, 8))"],"pitch":64},{"name":"Funk horns","calls":[".s(\"gm_brass_section\")",".decay(slider(0.3, 0, 2))",".sustain(slider(0.3, 0, 1))",".room(slider(0.3, 0, 1))"],"pitch":60},{"name":"Funk synth bass","calls":[".s(\"square\")",".lpf(slider(800, 100, 8000))",".lpq(slider(8, 0, 30))",".lpenv(slider(3, 0, 8))",".lpdecay(slider(0.08, 0, 1))",".decay(slider(0.15, 0, 2))",".sustain(slider(0.2, 0, 1))"],"pitch":40}],"snippets":[{"name":"funk-beat","code":"drums: stack(\n  s(\"funk_kick\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ x ~   ~ x ~ ~\"),\n  s(\"funk_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"funk_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"funk_openhat\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~\"),\n)\n  .swingBy(0.1, 8)"},{"name":"funk-clav","code":"drums: stack(\n  s(\"funk_clav\").struct(\"~ x ~ x   x ~ ~ x   ~ x ~ x   x ~ x ~\"),\n  s(\"funk_horns\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~\"),\n)"},{"name":"funk-slap","code":"slap: note(`\n  e2 ~ e3 ~   ~ e2 g2 ~   a2 ~ ~ e3   ~ d3 b2 ~\n`)\n  .s(\"gm_slap_bass_1\")\n  .decay(slider(0.4, 0, 2))\n  .sustain(slider(0.3, 0, 1))"}]}