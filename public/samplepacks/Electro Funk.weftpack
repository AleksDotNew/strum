{"weftpack":1,"id":"electro","name":"Electro Funk","by":"Weft Loom","about":"Electro at 128: a short boomy kick, a snappy snare and clap, a cowbell, toms, and a robot bass to play. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"electro_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"electro_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"electro_clap","file":"clap.wav","type":"audio/wav","seconds":0.45,"data":""},{"name":"electro_hat","file":"hat.wav","type":"audio/wav","seconds":0.151,"data":""},{"name":"electro_cowbell","file":"cowbell.wav","type":"audio/wav","seconds":0.3,"data":""},{"name":"electro_tom","file":"tom.wav","type":"audio/wav","seconds":0.5,"data":""}],"presets":[{"name":"Electro robot","calls":[".s(\"square\")",".lpf(slider(600, 100, 8000))",".lpq(slider(12, 0, 30))",".lpenv(slider(3.5, 0, 8))",".lpdecay(slider(0.1, 0, 1))",".decay(slider(0.15, 0, 2))",".sustain(slider(0.2, 0, 1))",".distort(slider(0.4, 0, 5))"],"pitch":36},{"name":"Electro lead","calls":[".s(\"sawtooth\")",".vib(slider(6, 0, 12))",".vibmod(slider(0.1, 0, 2))",".lpf(slider(2200, 100, 8000))",".lpq(slider(6, 0, 30))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.5, 0, 1))",".delay(slider(0.25, 0, 1))"],"pitch":72}],"snippets":[{"name":"electro-beat","code":"drums: stack(\n  s(\"electro_kick\").struct(\"x ~ ~ ~   ~ ~ x ~   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"electro_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"electro_clap\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"electro_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"electro_cowbell\").struct(\"~ ~ ~ x   ~ ~ ~ ~   ~ ~ ~ x   ~ ~ ~ ~\"),\n)"},{"name":"electro-bass","code":"bass: note(`\n  c2 ~ c2 c3   ~ c2 ~ d#2   ~ c2 c3 ~   g1 ~ a#1 ~\n`)\n  .s(\"square\")\n  .lpf(slider(600, 100, 8000))\n  .lpq(slider(12, 0, 30))\n  .lpenv(slider(3.5, 0, 8))\n  .lpdecay(slider(0.1, 0, 1))\n  .decay(slider(0.15, 0, 2))\n  .sustain(slider(0.2, 0, 1))\n  .distort(slider(0.4, 0, 5))"}]}