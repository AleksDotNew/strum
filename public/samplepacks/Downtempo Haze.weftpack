{"weftpack":1,"id":"haze","name":"Downtempo Haze","by":"Weft Loom","about":"Downtempo at 95: a soft kick, a brushed snare, shaker and rim, a warm tape texture, and keys and basses that are easy on the ear. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"haze_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"haze_brush","file":"brush.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"haze_shaker","file":"shaker.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"haze_rim","file":"rim.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"haze_texture","file":"texture.wav","type":"audio/wav","seconds":4,"data":""},{"name":"haze_keys","file":"keys.wav","type":"audio/wav","seconds":2.276,"data":""}],"presets":[{"name":"Haze piano","calls":[".s(\"gm_epiano1\")",".lpf(slider(3000, 100, 8000))",".room(slider(0.4, 0, 1))",".phaser(slider(0.3, 0, 8))",".chorus(slider(0.5, 0, 1))"],"pitch":60},{"name":"Haze lead","calls":[".s(\"triangle\")",".vib(slider(4, 0, 12))",".vibmod(slider(0.1, 0, 2))",".attack(slider(0.05, 0, 1))",".release(slider(0.4, 0, 2))",".delay(slider(0.35, 0, 1))",".room(slider(0.4, 0, 1))"],"pitch":72},{"name":"Haze bass","calls":[".s(\"sine\")",".attack(slider(0.02, 0, 1))",".decay(slider(0.5, 0, 2))",".sustain(slider(0.6, 0, 1))",".release(slider(0.2, 0, 2))",".distort(slider(0.2, 0, 5))"],"pitch":36}],"snippets":[{"name":"haze-beat","code":"drums: stack(\n  s(\"haze_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ ~ x   ~ ~ ~ ~\"),\n  s(\"haze_brush\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"haze_shaker\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n  s(\"haze_rim\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~\"),\n)\n  .swingBy(0.2, 8)"},{"name":"haze-warm","code":".lpf(2400).chorus(0.4).room(0.45)"}]}