{"weftpack":1,"id":"disco","name":"Nu Disco","by":"Weft Loom","about":"Nu disco at 118: a kick, a clap, an open hat on the off beat, a tambourine, two string stabs and an octave bass to play. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"disco_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"disco_clap","file":"clap.wav","type":"audio/wav","seconds":0.85,"data":""},{"name":"disco_hat","file":"hat.wav","type":"audio/wav","seconds":0.198,"data":""},{"name":"disco_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"disco_tambourine","file":"tambourine.wav","type":"audio/wav","seconds":0.35,"data":""},{"name":"disco_strings","file":"strings.wav","type":"audio/wav","seconds":1.3,"data":""},{"name":"disco_strings2","file":"strings2.wav","type":"audio/wav","seconds":1.3,"data":""}],"presets":[{"name":"Disco octave bass","calls":[".s(\"sawtooth\")",".lpf(slider(900, 100, 8000))",".lpq(slider(4, 0, 30))",".lpenv(slider(2, 0, 8))",".lpdecay(slider(0.1, 0, 1))",".decay(slider(0.15, 0, 2))",".sustain(slider(0.2, 0, 1))",".release(slider(0.05, 0, 2))"],"pitch":36},{"name":"Disco strings","calls":[".s(\"gm_string_ensemble_1\")",".attack(slider(0.05, 0, 1))",".release(slider(0.4, 0, 2))",".room(slider(0.4, 0, 1))"],"pitch":60},{"name":"Disco synth","calls":[".s(\"supersaw\")",".lpf(slider(3000, 100, 8000))",".attack(slider(0.01, 0, 1))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.5, 0, 1))",".delay(slider(0.25, 0, 1))",".chorus(slider(0.5, 0, 1))"],"pitch":72}],"snippets":[{"name":"disco-beat","code":"drums: stack(\n  s(\"disco_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"disco_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"disco_openhat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n  s(\"disco_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"disco_tambourine\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n)"},{"name":"disco-bass","code":"bass: note(`\n  d2 d3 d2 d3   d2 d3 d2 d3   c2 c3 c2 c3   a1 a2 c2 c3\n`)\n  .s(\"sawtooth\")\n  .lpf(slider(900, 100, 8000))\n  .lpq(slider(4, 0, 30))\n  .lpenv(slider(2, 0, 8))\n  .lpdecay(slider(0.1, 0, 1))\n  .decay(slider(0.15, 0, 2))\n  .sustain(slider(0.2, 0, 1))\n  .release(slider(0.05, 0, 2))"},{"name":"disco-strings","code":"drums: stack(\n  s(\"disco_strings\").struct(\"x ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"disco_strings2\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ x ~\"),\n)"}]}