{"weftpack":1,"id":"trance","name":"Trance Gate","by":"Weft Loom","about":"Trance at 138: a kick, a clap, hats, a supersaw pluck chord, a pad, a riser and a fall, and a bass for the off beats. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"trance_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"trance_clap","file":"clap.wav","type":"audio/wav","seconds":1.05,"data":""},{"name":"trance_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"trance_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.45,"data":""},{"name":"trance_pluck","file":"pluck.wav","type":"audio/wav","seconds":1.4,"data":""},{"name":"trance_pad","file":"pad.wav","type":"audio/wav","seconds":8,"data":""},{"name":"trance_riser","file":"riser.wav","type":"audio/wav","seconds":7,"data":""},{"name":"trance_fall","file":"fall.wav","type":"audio/wav","seconds":2.96,"data":""}],"presets":[{"name":"Trance pluck","calls":[".s(\"supersaw\")",".lpf(slider(1500, 100, 8000))",".lpenv(slider(5, 0, 8))",".lpdecay(slider(0.1, 0, 1))",".decay(slider(0.2, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.4, 0, 1))",".delayfeedback(slider(0.5, 0, 0.9))",".room(slider(0.5, 0, 1))"],"pitch":69},{"name":"Trance bass","calls":[".s(\"sawtooth\")",".lpf(slider(600, 100, 8000))",".lpq(slider(4, 0, 30))",".lpenv(slider(2, 0, 8))",".lpdecay(slider(0.08, 0, 1))",".decay(slider(0.12, 0, 2))",".sustain(slider(0, 0, 1))",".distort(slider(0.3, 0, 5))"],"pitch":33},{"name":"Trance lead","calls":[".s(\"supersaw\")",".vib(slider(4, 0, 12))",".vibmod(slider(0.1, 0, 2))",".lpf(slider(4000, 100, 8000))",".attack(slider(0.01, 0, 1))",".sustain(slider(0.8, 0, 1))",".release(slider(0.3, 0, 2))",".delay(slider(0.3, 0, 1))",".room(slider(0.5, 0, 1))"],"pitch":72},{"name":"Trance pad","calls":[".s(\"supersaw\")",".lpf(slider(1800, 100, 8000))",".attack(slider(0.9, 0, 1))",".release(slider(1.8, 0, 2))",".room(slider(0.7, 0, 1))",".roomsize(slider(8, 0, 10))",".chorus(slider(0.5, 0, 1))"],"pitch":57}],"snippets":[{"name":"trance-beat","code":"drums: stack(\n  s(\"trance_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"trance_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"trance_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"trance_openhat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n)"},{"name":"trance-bass","code":"bass: note(`\n  ~ ~ a1 ~   ~ ~ a1 ~   ~ ~ f1 ~   ~ ~ g1 ~\n`)\n  .s(\"sawtooth\")\n  .lpf(slider(600, 100, 8000))\n  .lpq(slider(4, 0, 30))\n  .lpenv(slider(2, 0, 8))\n  .lpdecay(slider(0.08, 0, 1))\n  .decay(slider(0.12, 0, 2))\n  .sustain(slider(0, 0, 1))\n  .distort(slider(0.3, 0, 5))"},{"name":"trance-arp","code":"plucks: note(`\n  a4 e4 c5 a4   e5 a4 c5 e4   f4 c5 a4 f5   g4 d5 b4 g5\n`)\n  .s(\"supersaw\")\n  .lpf(slider(1500, 100, 8000))\n  .lpenv(slider(5, 0, 8))\n  .lpdecay(slider(0.1, 0, 1))\n  .decay(slider(0.2, 0, 2))\n  .sustain(slider(0, 0, 1))\n  .delay(slider(0.4, 0, 1))\n  .delayfeedback(slider(0.5, 0, 0.9))\n  .room(slider(0.5, 0, 1))"}]}