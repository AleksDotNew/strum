{"weftpack":1,"id":"hands","name":"Hand Drums","by":"Weft Loom","about":"Hand percussion at 110: low and high congas, a bongo, a shaker, a clave and a cowbell, and a marimba and a kalimba to play. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"hands_conga","file":"conga.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"hands_congahi","file":"congahi.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"hands_bongo","file":"bongo.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"hands_shaker","file":"shaker.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"hands_clave","file":"clave.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"hands_cowbell","file":"cowbell.wav","type":"audio/wav","seconds":0.35,"data":""}],"presets":[{"name":"Hands marimba","calls":[".s(\"sine\")",".fm(slider(2, 0, 8))",".fmh(slider(4, 0.5, 8))",".fmdecay(slider(0.05, 0, 2))",".decay(slider(0.3, 0, 2))",".sustain(slider(0, 0, 1))",".release(slider(0.2, 0, 2))",".room(slider(0.3, 0, 1))"],"pitch":60},{"name":"Hands kalimba","calls":[".s(\"triangle\")",".fm(slider(1.5, 0, 8))",".fmh(slider(5, 0.5, 8))",".fmdecay(slider(0.08, 0, 2))",".decay(slider(0.35, 0, 2))",".sustain(slider(0, 0, 1))",".release(slider(0.3, 0, 2))",".room(slider(0.3, 0, 1))"],"pitch":72}],"snippets":[{"name":"hands-groove","code":"drums: stack(\n  s(\"hands_conga\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"hands_congahi\").struct(\"~ ~ x ~   ~ x ~ ~   x ~ x ~   ~ ~ x ~\"),\n  s(\"hands_bongo\").struct(\"~ x ~ ~   ~ ~ ~ x   ~ x ~ ~   ~ x ~ x\"),\n  s(\"hands_shaker\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"hands_clave\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ x ~   x ~ ~ ~\"),\n)"}]}