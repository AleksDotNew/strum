{"weftpack":1,"id":"dusty","name":"Dust Tapes","by":"Weft Loom","about":"Lo-fi at 84: a soft kick, a crushed snare, rim, hats, crackle and tape hiss, and keys that sound worn. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"dusty_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"dusty_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"dusty_rim","file":"rim.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"dusty_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"dusty_crackle","file":"crackle.wav","type":"audio/wav","seconds":4,"data":""},{"name":"dusty_tape","file":"tape.wav","type":"audio/wav","seconds":4,"data":""},{"name":"dusty_keys","file":"keys.wav","type":"audio/wav","seconds":2.07,"data":""}],"presets":[{"name":"Dusty keys","calls":[".s(\"piano\")",".lpf(slider(2000, 100, 8000))",".room(slider(0.3, 0, 1))",".crush(slider(9, 1, 16))"],"pitch":60},{"name":"Dusty electric","calls":[".s(\"gm_epiano1\")",".lpf(slider(2600, 100, 8000))",".room(slider(0.3, 0, 1))",".crush(slider(11, 1, 16))",".chorus(slider(0.5, 0, 1))"],"pitch":60},{"name":"Dusty bass","calls":[".s(\"triangle\")",".lpf(slider(600, 100, 8000))",".attack(slider(0.01, 0, 1))",".decay(slider(0.4, 0, 2))",".sustain(slider(0.5, 0, 1))",".release(slider(0.15, 0, 2))"],"pitch":36},{"name":"Dusty pad","calls":[".s(\"triangle\")",".lpf(slider(1500, 100, 8000))",".attack(slider(0.5, 0, 1))",".release(slider(1.2, 0, 2))",".room(slider(0.5, 0, 1))",".chorus(slider(0.6, 0, 1))"],"pitch":60}],"snippets":[{"name":"dusty-beat","code":"drums: stack(\n  s(\"dusty_kick\").struct(\"x ~ ~ ~   ~ ~ ~ x   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"dusty_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"dusty_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n  s(\"dusty_rim\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~\"),\n)\n  .swingBy(0.25, 8)"},{"name":"dusty-crackle","code":"drums: stack(\n  s(\"dusty_crackle\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n)"},{"name":"dusty-worn","code":".lpf(2200).crush(9).room(0.3)"}]}