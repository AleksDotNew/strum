{"weftpack":1,"id":"dub","name":"Dub Chords","by":"Weft Loom","about":"Dub techno at 120: a minor chord stab made to be echoed, a soft kick, rim, shaker and the hiss under it all. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"dub_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"dub_rim","file":"rim.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"dub_shaker","file":"shaker.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"dub_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"dub_chord","file":"chord.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"dub_hiss","file":"hiss.wav","type":"audio/wav","seconds":4,"data":""}],"presets":[{"name":"Dub chord","calls":[".s(\"sawtooth\")",".lpf(slider(800, 100, 8000))",".lpq(slider(6, 0, 30))",".decay(slider(0.12, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.8, 0, 1))",".delayfeedback(slider(0.74, 0, 0.9))",".room(slider(0.5, 0, 1))",".roomsize(slider(7, 0, 10))"],"pitch":53},{"name":"Dub pad","calls":[".s(\"supersaw\")",".lpf(slider(700, 100, 8000))",".attack(slider(0.8, 0, 1))",".release(slider(1.6, 0, 2))",".room(slider(0.7, 0, 1))",".roomsize(slider(8, 0, 10))",".phaser(slider(0.4, 0, 8))"],"pitch":53},{"name":"Dub sub","calls":[".s(\"sine\")",".attack(slider(0.01, 0, 1))",".decay(slider(0.4, 0, 2))",".sustain(slider(0.7, 0, 1))",".release(slider(0.2, 0, 2))"],"pitch":29}],"snippets":[{"name":"dub-beat","code":"drums: stack(\n  s(\"dub_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"dub_rim\").struct(\"~ ~ ~ x   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"dub_shaker\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"dub_hat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n)"},{"name":"dub-chords","code":"drums: stack(\n  s(\"dub_chord\").struct(\"~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ x\"),\n)\n  .delay(0.8).delayfeedback(0.72).delaysync(0.1875).room(0.5)"},{"name":"dub-space","code":".delay(0.8).delayfeedback(0.74).delaysync(0.1875).room(0.5).roomsize(7)"}]}