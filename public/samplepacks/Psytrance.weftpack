{"weftpack":1,"id":"psy","name":"Psytrance","by":"Weft Loom","about":"Psytrance at 145: a short kick, a rolling bass for the steps between, hats, a clap, a squelch, a zap and a riser. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"psy_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"psy_bass","file":"bass.wav","type":"audio/wav","seconds":0.12,"data":""},{"name":"psy_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"psy_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"psy_clap","file":"clap.wav","type":"audio/wav","seconds":0.95,"data":""},{"name":"psy_squelch","file":"squelch.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"psy_zap","file":"zap.wav","type":"audio/wav","seconds":1,"data":""},{"name":"psy_riser","file":"riser.wav","type":"audio/wav","seconds":3.3,"data":""}],"presets":[{"name":"Psy bass","calls":[".s(\"sawtooth\")",".lpf(slider(300, 100, 8000))",".lpq(slider(4, 0, 30))",".lpenv(slider(3, 0, 8))",".lpdecay(slider(0.05, 0, 1))",".decay(slider(0.08, 0, 2))",".sustain(slider(0, 0, 1))",".distort(slider(0.4, 0, 5))"],"pitch":28},{"name":"Psy lead","calls":[".s(\"sawtooth\")",".lpf(slider(900, 100, 8000))",".lpq(slider(20, 0, 30))",".lpenv(slider(5, 0, 8))",".lpdecay(slider(0.15, 0, 1))",".decay(slider(0.15, 0, 2))",".sustain(slider(0.2, 0, 1))",".delay(slider(0.4, 0, 1))",".delayfeedback(slider(0.6, 0, 0.9))",".phaser(slider(1, 0, 8))"],"pitch":64},{"name":"Psy pad","calls":[".s(\"supersaw\")",".lpf(slider(1200, 100, 8000))",".attack(slider(0.8, 0, 1))",".release(slider(1.5, 0, 2))",".room(slider(0.7, 0, 1))",".phaser(slider(1.5, 0, 8))"],"pitch":52}],"snippets":[{"name":"psy-beat","code":"drums: stack(\n  s(\"psy_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"psy_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"psy_openhat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n  s(\"psy_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n)"},{"name":"psy-roll","code":"drums: stack(\n  s(\"psy_bass\").struct(\"~ x x x   ~ x x x   ~ x x x   ~ x x x\"),\n)"},{"name":"psy-line","code":"lead: note(`\n  e3 ~ g3 e3   ~ b3 ~ e3   d4 ~ e3 ~   a3 ~ e3 g3\n`)\n  .s(\"sawtooth\")\n  .lpf(slider(900, 100, 8000))\n  .lpq(slider(20, 0, 30))\n  .lpenv(slider(5, 0, 8))\n  .lpdecay(slider(0.15, 0, 1))\n  .decay(slider(0.15, 0, 2))\n  .sustain(slider(0.2, 0, 1))\n  .delay(slider(0.4, 0, 1))\n  .delayfeedback(slider(0.6, 0, 0.9))\n  .phaser(slider(1, 0, 8))"}]}