{"weftpack":1,"id":"acid","name":"Acid Lines","by":"Weft Loom","about":"Acid at 132: squelching basses to play from the roll, a tight kit and a cowbell. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"acid_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"acid_clap","file":"clap.wav","type":"audio/wav","seconds":0.45,"data":""},{"name":"acid_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"acid_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"acid_cowbell","file":"cowbell.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"acid_squelch","file":"squelch.wav","type":"audio/wav","seconds":0.6,"data":""}],"presets":[{"name":"Acid squelch","calls":[".s(\"sawtooth\")",".lpf(slider(420, 100, 8000))",".lpq(slider(22, 0, 30))",".lpenv(slider(5, 0, 8))",".lpdecay(slider(0.14, 0, 1))",".decay(slider(0.15, 0, 2))",".sustain(slider(0.1, 0, 1))",".distort(slider(0.6, 0, 5))"],"pitch":36},{"name":"Acid screamer","calls":[".s(\"sawtooth\")",".lpf(slider(900, 100, 8000))",".lpq(slider(26, 0, 30))",".lpenv(slider(6, 0, 8))",".lpdecay(slider(0.2, 0, 1))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.2, 0, 1))",".delay(slider(0.3, 0, 1))",".delayfeedback(slider(0.5, 0, 0.9))",".distort(slider(1.2, 0, 5))"],"pitch":48},{"name":"Acid square","calls":[".s(\"square\")",".lpf(slider(500, 100, 8000))",".lpq(slider(18, 0, 30))",".lpenv(slider(4, 0, 8))",".lpdecay(slider(0.12, 0, 1))",".decay(slider(0.18, 0, 2))",".sustain(slider(0, 0, 1))",".distort(slider(0.5, 0, 5))"],"pitch":36},{"name":"Acid rubber","calls":[".s(\"square\")",".lpf(slider(300, 100, 8000))",".lpq(slider(12, 0, 30))",".lpenv(slider(3, 0, 8))",".lpdecay(slider(0.25, 0, 1))",".decay(slider(0.3, 0, 2))",".sustain(slider(0.3, 0, 1))"],"pitch":36}],"snippets":[{"name":"acid-beat","code":"drums: stack(\n  s(\"acid_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"acid_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"acid_openhat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n  s(\"acid_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n)"},{"name":"acid-line","code":"acid: note(`\n  a1 a1 a2 a1   ~  a1 a#1 a1   a2 a1 ~  a1   c2 a1 a2 g1\n`)\n  .s(\"sawtooth\")\n  .lpf(slider(420, 100, 8000))\n  .lpq(slider(22, 0, 30))\n  .lpenv(slider(5, 0, 8))\n  .lpdecay(slider(0.14, 0, 1))\n  .decay(slider(0.15, 0, 2))\n  .sustain(slider(0.1, 0, 1))\n  .distort(slider(0.6, 0, 5))"},{"name":"acid-bell","code":"drums: stack(\n  s(\"acid_cowbell\").struct(\"~ ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   x ~ ~ ~\"),\n)"}]}