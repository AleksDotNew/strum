{"weftpack":1,"id":"glitch","name":"Glitch Lab","by":"Weft Loom","about":"Glitch and IDM at 110: bursts of crushed noise and tone, clicks, a broken kick and snare, and a texture that stutters. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"glitch_burst","file":"burst.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"glitch_burst2","file":"burst2.wav","type":"audio/wav","seconds":0.8,"data":""},{"name":"glitch_burst3","file":"burst3.wav","type":"audio/wav","seconds":0.3,"data":""},{"name":"glitch_click","file":"click.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"glitch_kick","file":"kick.wav","type":"audio/wav","seconds":0.599,"data":""},{"name":"glitch_snare","file":"snare.wav","type":"audio/wav","seconds":0.34,"data":""},{"name":"glitch_stutter","file":"stutter.wav","type":"audio/wav","seconds":0.878,"data":""}],"presets":[{"name":"Glitch bleep","calls":[".s(\"sine\")",".fm(slider(6, 0, 8))",".fmh(slider(7.1, 0.5, 8))",".fmdecay(slider(0.05, 0, 2))",".decay(slider(0.08, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.4, 0, 1))",".delayfeedback(slider(0.6, 0, 0.9))",".crush(slider(6, 1, 16))"],"pitch":79},{"name":"Glitch bass","calls":[".s(\"square\")",".lpf(slider(800, 100, 8000))",".lpq(slider(10, 0, 30))",".lpenv(slider(3, 0, 8))",".decay(slider(0.1, 0, 2))",".sustain(slider(0, 0, 1))",".distort(slider(0.6, 0, 5))",".coarse(slider(8, 1, 32))"],"pitch":36}],"snippets":[{"name":"glitch-beat","code":"drums: stack(\n  s(\"glitch_kick\").struct(\"x ~ ~ x   ~ ~ x ~   ~ x ~ ~   x ~ ~ ~\"),\n  s(\"glitch_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ x   x ~ ~ ~\"),\n  s(\"glitch_click\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"glitch_burst\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~\"),\n)\n  .degradeBy(0.15)"},{"name":"glitch-fx","code":".crush(6).coarse(6).delay(0.4).delayfeedback(0.6).delaysync(0.125)"}]}