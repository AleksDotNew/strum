{"weftpack":1,"id":"trap","name":"Trap Sub","by":"Weft Loom","about":"Trap at 140, felt at half the speed: a long 808, a punchy kick, snare and clap, hats to roll, and a dark bell. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"trap_boom","file":"boom.wav","type":"audio/wav","seconds":2,"data":""},{"name":"trap_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"trap_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"trap_clap","file":"clap.wav","type":"audio/wav","seconds":0.45,"data":""},{"name":"trap_hat","file":"hat.wav","type":"audio/wav","seconds":0.187,"data":""},{"name":"trap_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"trap_bell","file":"bell.wav","type":"audio/wav","seconds":2,"data":""}],"presets":[{"name":"Trap 808","calls":[".s(\"sine\")",".attack(slider(0.01, 0, 1))",".decay(slider(0.9, 0, 2))",".sustain(slider(0.5, 0, 1))",".release(slider(0.3, 0, 2))",".distort(slider(0.8, 0, 5))"],"pitch":31},{"name":"Trap bell","calls":[".s(\"sine\")",".fm(slider(3, 0, 8))",".fmh(slider(2.76, 0.5, 8))",".fmdecay(slider(0.5, 0, 2))",".decay(slider(1, 0, 2))",".sustain(slider(0, 0, 1))",".release(slider(0.6, 0, 2))",".room(slider(0.4, 0, 1))"],"pitch":72},{"name":"Trap lead","calls":[".s(\"square\")",".vib(slider(5, 0, 12))",".vibmod(slider(0.2, 0, 2))",".lpf(slider(2800, 100, 8000))",".attack(slider(0.01, 0, 1))",".release(slider(0.2, 0, 2))",".delay(slider(0.3, 0, 1))"],"pitch":72}],"snippets":[{"name":"trap-beat","code":"drums: stack(\n  s(\"trap_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"trap_snare\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"trap_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n)\n  .lastOf(2, ply(2))"},{"name":"trap-808","code":"drums: stack(\n  s(\"trap_boom\").struct(\"x ~ ~ ~   ~ ~ ~ x   ~ ~ x ~   ~ ~ ~ ~\"),\n)"},{"name":"trap-bells","code":"drums: stack(\n  s(\"trap_bell\").struct(\"~ ~ x ~   ~ ~ ~ ~   ~ x ~ ~   ~ ~ x ~\"),\n)\n  .delay(0.4).room(0.4)"}]}