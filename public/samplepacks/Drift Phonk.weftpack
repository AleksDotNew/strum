{"weftpack":1,"id":"phonk","name":"Drift Phonk","by":"Weft Loom","about":"Drift phonk at 130: a cowbell to play tunes on, a distorted 808, a hard kick, a snare and clap, hats and a low voice. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"phonk_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"phonk_boom","file":"boom.wav","type":"audio/wav","seconds":1.4,"data":""},{"name":"phonk_cowbell","file":"cowbell.wav","type":"audio/wav","seconds":0.8,"data":""},{"name":"phonk_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"phonk_clap","file":"clap.wav","type":"audio/wav","seconds":0.45,"data":""},{"name":"phonk_hat","file":"hat.wav","type":"audio/wav","seconds":0.186,"data":""},{"name":"phonk_voice","file":"voice.wav","type":"audio/wav","seconds":1.2,"data":""}],"presets":[{"name":"Phonk cowbell","calls":[".s(\"square\")",".bpf(slider(900, 100, 8000))",".bpq(slider(3, 0, 30))",".decay(slider(0.15, 0, 2))",".sustain(slider(0, 0, 1))",".room(slider(0.3, 0, 1))",".distort(slider(1.5, 0, 5))"],"pitch":72},{"name":"Phonk 808","calls":[".s(\"sine\")",".attack(slider(0.01, 0, 1))",".decay(slider(0.8, 0, 2))",".sustain(slider(0.3, 0, 1))",".release(slider(0.2, 0, 2))",".distort(slider(2, 0, 5))",".gain(slider(0.5, 0, 1.5))"],"pitch":33},{"name":"Phonk lead","calls":[".s(\"sawtooth\")",".lpf(slider(1800, 100, 8000))",".lpq(slider(6, 0, 30))",".decay(slider(0.3, 0, 2))",".sustain(slider(0.4, 0, 1))",".delay(slider(0.3, 0, 1))",".distort(slider(0.8, 0, 5))"],"pitch":67}],"snippets":[{"name":"phonk-beat","code":"drums: stack(\n  s(\"phonk_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ x ~   ~ ~ ~ ~\"),\n  s(\"phonk_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"phonk_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"phonk_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n)"},{"name":"phonk-bells","code":"bell: note(`\n  c5 ~ c5 d#5   ~ c5 ~ g4   a#4 ~ c5 ~   g4 ~ d#4 ~\n`)\n  .s(\"square\")\n  .bpf(slider(900, 100, 8000))\n  .bpq(slider(3, 0, 30))\n  .decay(slider(0.15, 0, 2))\n  .sustain(slider(0, 0, 1))\n  .room(slider(0.3, 0, 1))\n  .distort(slider(1.5, 0, 5))"},{"name":"phonk-808","code":"drums: stack(\n  s(\"phonk_boom\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ x ~   ~ ~ ~ ~\"),\n  s(\"phonk_voice\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n)"}]}