{"weftpack":1,"id":"cinema","name":"Cinematic Hits","by":"Weft Loom","about":"Cinematic sounds at any tempo: an impact, a boom, a riser and a fall, a whoosh, a dark drone, a braam and a tick for tension. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"cinema_impact","file":"impact.wav","type":"audio/wav","seconds":3.081,"data":""},{"name":"cinema_boom","file":"boom.wav","type":"audio/wav","seconds":2.478,"data":""},{"name":"cinema_riser","file":"riser.wav","type":"audio/wav","seconds":6,"data":""},{"name":"cinema_fall","file":"fall.wav","type":"audio/wav","seconds":2.96,"data":""},{"name":"cinema_whoosh","file":"whoosh.wav","type":"audio/wav","seconds":1.393,"data":""},{"name":"cinema_drone","file":"drone.wav","type":"audio/wav","seconds":8,"data":""},{"name":"cinema_braam","file":"braam.wav","type":"audio/wav","seconds":4.495,"data":""},{"name":"cinema_tick","file":"tick.wav","type":"audio/wav","seconds":0.023,"data":""}],"presets":[{"name":"Cinema pad","calls":[".s(\"supersaw\")",".lpf(slider(900, 100, 8000))",".attack(slider(1.5, 0, 1))",".release(slider(2, 0, 2))",".room(slider(0.8, 0, 1))",".roomsize(slider(9, 0, 10))"],"pitch":48},{"name":"Cinema brass","calls":[".s(\"sawtooth\")",".lpf(slider(800, 100, 8000))",".lpenv(slider(3, 0, 8))",".lpdecay(slider(0.6, 0, 1))",".attack(slider(0.15, 0, 1))",".sustain(slider(0.8, 0, 1))",".release(slider(0.6, 0, 2))",".room(slider(0.5, 0, 1))",".distort(slider(0.4, 0, 5))"],"pitch":48},{"name":"Cinema pulse","calls":[".s(\"sawtooth\")",".lpf(slider(500, 100, 8000))",".lpq(slider(6, 0, 30))",".decay(slider(0.12, 0, 2))",".sustain(slider(0, 0, 1))",".room(slider(0.3, 0, 1))"],"pitch":36}],"snippets":[{"name":"cinema-tension","code":"drums: stack(\n  s(\"cinema_tick\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n  s(\"cinema_boom\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n)"},{"name":"cinema-drop","code":"drums: stack(\n  s(\"cinema_impact\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"cinema_braam\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n)\n  .slow(2)"}]}