{"weftpack":1,"id":"drive","name":"Night Drive","by":"Weft Loom","about":"Synthwave at 100: a big gated snare, a punchy kick, toms for fills, a warm pad and basses to arpeggiate. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"drive_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"drive_snare","file":"snare.wav","type":"audio/wav","seconds":0.392,"data":""},{"name":"drive_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"drive_tom","file":"tom.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"drive_lowtom","file":"lowtom.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"drive_pad","file":"pad.wav","type":"audio/wav","seconds":6,"data":""}],"presets":[{"name":"Drive bass","calls":[".s(\"sawtooth\")",".lpf(slider(700, 100, 8000))",".lpq(slider(4, 0, 30))",".lpenv(slider(1.5, 0, 8))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.5, 0, 1))",".release(slider(0.1, 0, 2))"],"pitch":33},{"name":"Drive arp","calls":[".s(\"square\")",".lpf(slider(2400, 100, 8000))",".lpq(slider(3, 0, 30))",".decay(slider(0.15, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.35, 0, 1))",".delayfeedback(slider(0.45, 0, 0.9))",".room(slider(0.3, 0, 1))"],"pitch":69},{"name":"Drive brass","calls":[".s(\"supersaw\")",".lpf(slider(2000, 100, 8000))",".lpenv(slider(2, 0, 8))",".attack(slider(0.05, 0, 1))",".decay(slider(0.4, 0, 2))",".sustain(slider(0.7, 0, 1))",".release(slider(0.3, 0, 2))",".chorus(slider(0.4, 0, 1))"],"pitch":60},{"name":"Drive pad","calls":[".s(\"sawtooth\")",".lpf(slider(1400, 100, 8000))",".attack(slider(0.7, 0, 1))",".release(slider(1.5, 0, 2))",".room(slider(0.6, 0, 1))",".roomsize(slider(6, 0, 10))",".chorus(slider(0.7, 0, 1))"],"pitch":60}],"snippets":[{"name":"drive-beat","code":"drums: stack(\n  s(\"drive_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ x ~   ~ ~ ~ ~\"),\n  s(\"drive_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"drive_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n)"},{"name":"drive-fill","code":"drums: stack(\n  s(\"drive_tom\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ x ~   ~ ~ ~ ~\"),\n  s(\"drive_lowtom\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   x ~ x x\"),\n)"},{"name":"drive-arp","code":"arp: note(`\n  a3 c4 e4 a4   e4 c4 a3 c4   f3 a3 c4 f4   c4 a3 f3 a3\n`)\n  .s(\"square\")\n  .lpf(slider(2400, 100, 8000))\n  .lpq(slider(3, 0, 30))\n  .decay(slider(0.15, 0, 2))\n  .sustain(slider(0, 0, 1))\n  .delay(slider(0.35, 0, 1))\n  .delayfeedback(slider(0.45, 0, 0.9))\n  .room(slider(0.3, 0, 1))"}]}