{"weftpack":1,"id":"deep","name":"Deep House","by":"Weft Loom","about":"Deep house at 122: a round kick, clap, hats and a shaker, and a minor ninth chord to stab or pad with. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"deep_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"deep_clap","file":"clap.wav","type":"audio/wav","seconds":0.85,"data":""},{"name":"deep_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"deep_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"deep_shaker","file":"shaker.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"deep_chord","file":"chord.wav","type":"audio/wav","seconds":0.8,"data":""}],"presets":[{"name":"Deep chord","calls":[".s(\"sawtooth\")",".lpf(slider(1100, 100, 8000))",".lpq(slider(3, 0, 30))",".decay(slider(0.3, 0, 2))",".sustain(slider(0.1, 0, 1))",".room(slider(0.5, 0, 1))",".chorus(slider(0.4, 0, 1))"],"pitch":57},{"name":"Deep bass","calls":[".s(\"sine\")",".fm(slider(1, 0, 8))",".fmh(slider(1, 0.5, 8))",".fmdecay(slider(0.1, 0, 2))",".decay(slider(0.3, 0, 2))",".sustain(slider(0.6, 0, 1))",".release(slider(0.1, 0, 2))"],"pitch":33},{"name":"Deep pad","calls":[".s(\"supersaw\")",".lpf(slider(1200, 100, 8000))",".attack(slider(0.6, 0, 1))",".release(slider(1.5, 0, 2))",".room(slider(0.6, 0, 1))",".roomsize(slider(6, 0, 10))"],"pitch":57}],"snippets":[{"name":"deep-beat","code":"drums: stack(\n  s(\"deep_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"deep_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"deep_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"deep_openhat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n)"},{"name":"deep-stabs","code":"drums: stack(\n  s(\"deep_chord\").struct(\"~ ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n)\n  .room(0.4)"}]}