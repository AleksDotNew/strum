{"weftpack":1,"id":"iron","name":"Industrial Iron","by":"Weft Loom","about":"Industrial at 125: a distorted kick, struck metal, a pipe, a noise snare and a clang with a room around it. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"iron_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"iron_metal","file":"metal.wav","type":"audio/wav","seconds":2.399,"data":""},{"name":"iron_metal2","file":"metal2.wav","type":"audio/wav","seconds":2.399,"data":""},{"name":"iron_pipe","file":"pipe.wav","type":"audio/wav","seconds":0.822,"data":""},{"name":"iron_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"iron_clang","file":"clang.wav","type":"audio/wav","seconds":2.241,"data":""}],"presets":[{"name":"Iron grind","calls":[".s(\"square\")",".lpf(slider(700, 100, 8000))",".lpq(slider(8, 0, 30))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.3, 0, 1))",".distort(slider(2.5, 0, 5))",".coarse(slider(4, 1, 32))"],"pitch":36},{"name":"Iron screech","calls":[".s(\"sawtooth\")",".lpf(slider(3000, 100, 8000))",".lpq(slider(20, 0, 30))",".lpenv(slider(3, 0, 8))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.3, 0, 1))",".delay(slider(0.3, 0, 1))",".distort(slider(1.5, 0, 5))"],"pitch":72}],"snippets":[{"name":"iron-beat","code":"drums: stack(\n  s(\"iron_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"iron_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"iron_metal\").struct(\"~ ~ x ~   ~ x ~ ~   ~ ~ x ~   ~ ~ ~ x\"),\n  s(\"iron_pipe\").struct(\"~ ~ ~ ~   ~ ~ ~ x   ~ ~ ~ ~   ~ x ~ ~\"),\n)"},{"name":"iron-clang","code":"drums: stack(\n  s(\"iron_clang\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"iron_metal2\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n)\n  .delay(0.5).delayfeedback(0.6)"}]}