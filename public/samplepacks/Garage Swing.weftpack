{"weftpack":1,"id":"garage","name":"Garage Swing","by":"Weft Loom","about":"UK garage at 132: a two-step kit that swings, a shaker, and an organ stab with a garage bass to play under it. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"garage_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"garage_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"garage_clap","file":"clap.wav","type":"audio/wav","seconds":0.45,"data":""},{"name":"garage_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"garage_shaker","file":"shaker.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"garage_organ","file":"organ.wav","type":"audio/wav","seconds":0.5,"data":""}],"presets":[{"name":"Garage organ","calls":[".s(\"gm_drawbar_organ\")",".decay(slider(0.3, 0, 2))",".sustain(slider(0.2, 0, 1))",".room(slider(0.3, 0, 1))",".chorus(slider(0.4, 0, 1))"],"pitch":60},{"name":"Garage bass","calls":[".s(\"square\")",".lpf(slider(500, 100, 8000))",".lpq(slider(6, 0, 30))",".lpenv(slider(2, 0, 8))",".lpdecay(slider(0.15, 0, 1))",".decay(slider(0.3, 0, 2))",".sustain(slider(0.4, 0, 1))",".release(slider(0.1, 0, 2))"],"pitch":36},{"name":"Garage pluck","calls":[".s(\"triangle\")",".fm(slider(1.5, 0, 8))",".fmh(slider(4, 0.5, 8))",".fmdecay(slider(0.1, 0, 2))",".decay(slider(0.3, 0, 2))",".sustain(slider(0, 0, 1))",".room(slider(0.3, 0, 1))"],"pitch":67}],"snippets":[{"name":"garage-twostep","code":"drums: stack(\n  s(\"garage_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"garage_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"garage_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n  s(\"garage_shaker\").struct(\"~ x ~ x   ~ x ~ x   ~ x ~ x   ~ x ~ x\"),\n)\n  .swingBy(0.3, 8)"},{"name":"garage-organ","code":"drums: stack(\n  s(\"garage_organ\").struct(\"~ ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   ~ x ~ ~\"),\n)"}]}