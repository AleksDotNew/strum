{"weftpack":1,"id":"baile","name":"Baile Funk","by":"Weft Loom","about":"Baile funk at 130: the tamborzão on a booming kick and two hand drums, a clap, hats, a samba whistle and a shout. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"baile_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"baile_drum","file":"drum.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"baile_drumhi","file":"drumhi.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"baile_clap","file":"clap.wav","type":"audio/wav","seconds":0.75,"data":""},{"name":"baile_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"baile_whistle","file":"whistle.wav","type":"audio/wav","seconds":0.35,"data":""},{"name":"baile_shout","file":"shout.wav","type":"audio/wav","seconds":0.6,"data":""}],"presets":[{"name":"Baile 808","calls":[".s(\"sine\")",".attack(slider(0.01, 0, 1))",".decay(slider(0.4, 0, 2))",".sustain(slider(0.2, 0, 1))",".distort(slider(2, 0, 5))"],"pitch":36},{"name":"Baile synth","calls":[".s(\"square\")",".lpf(slider(2500, 100, 8000))",".decay(slider(0.15, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.25, 0, 1))",".delayfeedback(slider(0.4, 0, 0.9))"],"pitch":72},{"name":"Baile horn","calls":[".s(\"gm_brass_section\")",".decay(slider(0.25, 0, 2))",".sustain(slider(0, 0, 1))",".room(slider(0.2, 0, 1))"],"pitch":60}],"snippets":[{"name":"baile-tamborzao","code":"drums: stack(\n  s(\"baile_kick\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ x ~   x ~ ~ ~\"),\n  s(\"baile_drum\").struct(\"~ ~ x ~   ~ x ~ ~   x ~ ~ x   ~ ~ x ~\"),\n  s(\"baile_drumhi\").struct(\"~ x ~ ~   ~ ~ ~ x   ~ x ~ ~   ~ x ~ x\"),\n  s(\"baile_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"baile_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n)"},{"name":"baile-calls","code":"drums: stack(\n  s(\"baile_whistle\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   x ~ x ~\"),\n  s(\"baile_shout\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n)"}]}