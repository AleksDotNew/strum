{"weftpack":1,"id":"space","name":"Space Drift","by":"Weft Loom","about":"Spacey electronica at 118: a soft kick, a filtered snare, a sweeping drone, radio bleeps, a bell and a laser zap. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"space_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"space_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"space_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"space_drone","file":"drone.wav","type":"audio/wav","seconds":8,"data":""},{"name":"space_bleep","file":"bleep.wav","type":"audio/wav","seconds":1.2,"data":""},{"name":"space_bell","file":"bell.wav","type":"audio/wav","seconds":3.282,"data":""},{"name":"space_zap","file":"zap.wav","type":"audio/wav","seconds":0.9,"data":""}],"presets":[{"name":"Space pad","calls":[".s(\"supersaw\")",".lpf(slider(1500, 100, 8000))",".attack(slider(1, 0, 1))",".release(slider(2, 0, 2))",".room(slider(0.8, 0, 1))",".roomsize(slider(9, 0, 10))",".phaser(slider(0.5, 0, 8))"],"pitch":52},{"name":"Space lead","calls":[".s(\"sine\")",".vib(slider(5, 0, 12))",".vibmod(slider(0.3, 0, 2))",".fm(slider(1, 0, 8))",".fmh(slider(2, 0.5, 8))",".delay(slider(0.5, 0, 1))",".delayfeedback(slider(0.6, 0, 0.9))",".room(slider(0.6, 0, 1))"],"pitch":76},{"name":"Space bass","calls":[".s(\"triangle\")",".lpf(slider(800, 100, 8000))",".decay(slider(0.3, 0, 2))",".sustain(slider(0.5, 0, 1))",".release(slider(0.2, 0, 2))"],"pitch":40}],"snippets":[{"name":"space-beat","code":"drums: stack(\n  s(\"space_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"space_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"space_hat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n)"},{"name":"space-signals","code":"drums: stack(\n  s(\"space_bleep\").struct(\"~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"space_zap\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ x\"),\n)\n 