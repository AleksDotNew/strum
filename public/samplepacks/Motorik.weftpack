{"weftpack":1,"id":"motorik","name":"Motorik","by":"Weft Loom","about":"Motorik at 120, the steady beat of krautrock: a kick, a snare, hats and a tambourine, a pulsing bass and an organ that holds. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"motorik_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"motorik_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"motorik_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"motorik_tambourine","file":"tambourine.wav","type":"audio/wav","seconds":0.35,"data":""},{"name":"motorik_pulse","file":"pulse.wav","type":"audio/wav","seconds":0.25,"data":""},{"name":"motorik_organ","file":"organ.wav","type":"audio/wav","seconds":4,"data":""}],"presets":[{"name":"Motorik bass","calls":[".s(\"sawtooth\")",".lpf(slider(600, 100, 8000))",".lpq(slider(4, 0, 30))",".lpenv(slider(1.5, 0, 8))",".decay(slider(0.15, 0, 2))",".sustain(slider(0.2, 0, 1))"],"pitch":40},{"name":"Motorik organ","calls":[".s(\"gm_drawbar_organ\")",".attack(slider(0.05, 0, 1))",".release(slider(0.4, 0, 2))",".room(slider(0.4, 0, 1))",".chorus(slider(0.5, 0, 1))"],"pitch":52},{"name":"Motorik guitar","calls":[".s(\"gm_electric_guitar_muted\")",".delay(slider(0.3, 0, 1))",".delayfeedback(slider(0.4, 0, 0.9))",".room(slider(0.3, 0, 1))"],"pitch":64},{"name":"Motorik synth","calls":[".s(\"square\")",".lpf(slider(1600, 100, 8000))",".attack(slider(0.02, 0, 1))",".sustain(slider(0.6, 0, 1))",".release(slider(0.3, 0, 2))",".phaser(slider(1, 0, 8))"],"pitch":64}],"snippets":[{"name":"motorik-beat","code":"drums: stack(\n  s(\"motorik_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ x ~   ~ ~ ~ ~\"),\n  s(\"motorik_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"motorik_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n  s(\"motorik_tambourine\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n)"},{"name":"motorik-pulse","code":"drums: stack(\n  s(\"motorik_pulse\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n)"},{"name":"motorik-hold","code":"drums: stack(\n  s(\"motorik_organ\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n)"}]}