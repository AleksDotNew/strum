{"weftpack":1,"id":"minimal","name":"Minimal Click","by":"Weft Loom","about":"Minimal at 124: a tight kick, clicks and ticks, a rim, a wood block and a small sub blip. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"minimal_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"minimal_click","file":"click.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"minimal_tick","file":"tick.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"minimal_rim","file":"rim.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"minimal_wood","file":"wood.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"minimal_blip","file":"blip.wav","type":"audio/wav","seconds":0.25,"data":""}],"presets":[{"name":"Minimal pluck","calls":[".s(\"triangle\")",".decay(slider(0.06, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.4, 0, 1))",".delayfeedback(slider(0.55, 0, 0.9))"],"pitch":60},{"name":"Minimal sub","calls":[".s(\"sine\")",".decay(slider(0.15, 0, 2))",".sustain(slider(0, 0, 1))",".release(slider(0.05, 0, 2))"],"pitch":33}],"snippets":[{"name":"minimal-beat","code":"drums: stack(\n  s(\"minimal_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"minimal_click\").struct(\"~ ~ x ~   ~ x ~ ~   ~ ~ x ~   ~ ~ ~ x\"),\n  s(\"minimal_tick\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"minimal_rim\").struct(\"~ ~ ~ ~   ~ ~ ~ x   ~ ~ ~ ~   ~ x ~ ~\"),\n  s(\"minimal_wood\").struct(\"~ x ~ ~   ~ ~ ~ ~   ~ ~ ~ x   ~ ~ ~ ~\"),\n)"},{"name":"minimal-blips","code":"drums: stack(\n  s(\"minimal_blip\").struct(\"~ ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   ~ x ~ ~\"),\n)"}]}