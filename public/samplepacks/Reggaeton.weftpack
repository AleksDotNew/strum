{"weftpack":1,"id":"dembow","name":"Reggaeton","by":"Weft Loom","about":"Reggaeton at 95: the dembow on a kick and snare, a rim, a timbal, a guiro and hats, and a bass, a pluck and a lead to play over it. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"dembow_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"dembow_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"dembow_rim","file":"rim.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"dembow_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"dembow_timbal","file":"timbal.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"dembow_guiro","file":"guiro.wav","type":"audio/wav","seconds":0.25,"data":""}],"presets":[{"name":"Dembow bass","calls":[".s(\"sine\")",".attack(slider(0.01, 0, 1))",".decay(slider(0.5, 0, 2))",".sustain(slider(0.4, 0, 1))",".release(slider(0.1, 0, 2))",".distort(slider(0.5, 0, 5))"],"pitch":33},{"name":"Dembow pluck","calls":[".s(\"triangle\")",".fm(slider(1, 0, 8))",".fmh(slider(3, 0.5, 8))",".fmdecay(slider(0.1, 0, 2))",".decay(slider(0.25, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.3, 0, 1))",".room(slider(0.3, 0, 1))"],"pitch":67},{"name":"Dembow lead","calls":[".s(\"square\")",".vib(slider(5, 0, 12))",".vibmod(slider(0.15, 0, 2))",".lpf(slider(2500, 100, 8000))",".attack(slider(0.01, 0, 1))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.4, 0, 1))",".delay(slider(0.25, 0, 1))"],"pitch":72}],"snippets":[{"name":"dembow-beat","code":"drums: stack(\n  s(\"dembow_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"dembow_snare\").struct(\"~ ~ ~ x   ~ ~ x ~   ~ ~ ~ x   ~ ~ x ~\"),\n  s(\"dembow_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n  s(\"dembow_rim\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ x\"),\n)"},{"name":"dembow-perc","code":"drums: stack(\n  s(\"dembow_timbal\").struct(\"~ ~ x ~   ~ ~ ~ ~   ~ ~ x ~   ~ x ~ ~\"),\n  s(\"dembow_guiro\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n)"}]}