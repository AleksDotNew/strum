{"weftpack":1,"id":"drill","name":"UK Drill","by":"Weft Loom","about":"UK drill at 142: 808s that slide down and up, a kick, a snare that falls late, a rim, hats that skip, and a dark piano and strings. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"drill_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"drill_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"drill_rim","file":"rim.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"drill_hat","file":"hat.wav","type":"audio/wav","seconds":0.189,"data":""},{"name":"drill_slide","file":"slide.wav","type":"audio/wav","seconds":1.6,"data":""},{"name":"drill_slideup","file":"slideup.wav","type":"audio/wav","seconds":1.6,"data":""},{"name":"drill_boom","file":"boom.wav","type":"audio/wav","seconds":1.6,"data":""}],"presets":[{"name":"Drill piano","calls":[".s(\"piano\")",".lpf(slider(2500, 100, 8000))",".room(slider(0.4, 0, 1))",".roomsize(slider(5, 0, 10))"],"pitch":60},{"name":"Drill strings","calls":[".s(\"gm_string_ensemble_1\")",".lpf(slider(2000, 100, 8000))",".attack(slider(0.2, 0, 1))",".release(slider(0.8, 0, 2))",".room(slider(0.5, 0, 1))"],"pitch":55},{"name":"Drill 808","calls":[".s(\"sine\")",".attack(slider(0.01, 0, 1))",".decay(slider(1, 0, 2))",".sustain(slider(0.4, 0, 1))",".release(slider(0.3, 0, 2))",".distort(slider(1.2, 0, 5))"],"pitch":31}],"snippets":[{"name":"drill-beat","code":"drums: stack(\n  s(\"drill_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"drill_snare\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ x\"),\n  s(\"drill_hat\").struct(\"x ~ x x   ~ x ~ x   x ~ x ~   ~ x x ~\"),\n  s(\"drill_rim\").struct(\"~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n)"},{"name":"drill-slides","code":"drums: stack(\n  s(\"drill_slide\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"drill_slideup\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~\"),\n)"},{"name":"drill-keys","code":"keys: note(`\n  g3 ~ a#3 ~   d4 ~ ~ ~   d#4 ~ d4 ~   a#3 ~ ~ ~\n`).slow(2)\n  .s(\"piano\")\n  .lpf(slider(2500, 100, 8000))\n  .room(slider(0.4, 0, 1))\n  .roomsize(slider(5, 0, 10))"}]}