{"weftpack":1,"id":"dubstep","name":"Dubstep Wobble","by":"Weft Loom","about":"Dubstep at 140, felt at half the speed: a kick and a big snare on the third beat, hats, two wobble basses, a sub and a riser, and a growl to play. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"dubstep_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"dubstep_snare","file":"snare.wav","type":"audio/wav","seconds":1,"data":""},{"name":"dubstep_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"dubstep_wobble","file":"wobble.wav","type":"audio/wav","seconds":0.86,"data":""},{"name":"dubstep_wobblefast","file":"wobblefast.wav","type":"audio/wav","seconds":0.86,"data":""},{"name":"dubstep_sub","file":"sub.wav","type":"audio/wav","seconds":1.6,"data":""},{"name":"dubstep_riser","file":"riser.wav","type":"audio/wav","seconds":3.4,"data":""}],"presets":[{"name":"Dubstep growl","calls":[".s(\"sawtooth\")",".lpf(slider(700, 100, 8000))",".lpq(slider(14, 0, 30))",".lpenv(slider(4, 0, 8))",".lpdecay(slider(0.3, 0, 1))",".sustain(slider(0.8, 0, 1))",".distort(slider(2, 0, 5))",".phaser(slider(2, 0, 8))"],"pitch":29},{"name":"Dubstep sub","calls":[".s(\"sine\")",".attack(slider(0.01, 0, 1))",".sustain(slider(0.9, 0, 1))",".release(slider(0.2, 0, 2))"],"pitch":29},{"name":"Dubstep reese","calls":[".s(\"supersaw\")",".lpf(slider(500, 100, 8000))",".lpq(slider(6, 0, 30))",".sustain(slider(0.9, 0, 1))",".distort(slider(0.6, 0, 5))",".phaser(slider(0.8, 0, 8))"],"pitch":29}],"snippets":[{"name":"dubstep-beat","code":"drums: stack(\n  s(\"dubstep_kick\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"dubstep_snare\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"dubstep_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n)"},{"name":"dubstep-wobs","code":"drums: stack(\n  s(\"dubstep_wobble\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"dubstep_wobblefast\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n)"},{"name":"dubstep-wobble","code":".segment(16).lpf(sine.range(200, 2400).fast(4)).lpq(10).distort(1.5)"}]}