{"weftpack":1,"id":"gabber","name":"Gabber Rush","by":"Weft Loom","about":"Hardcore at 180: a kick distorted until it whistles, a snare and hats, and a hoover and a rave stab to play. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"gabber_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"gabber_kick2","file":"kick2.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"gabber_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"gabber_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"gabber_stab","file":"stab.wav","type":"audio/wav","seconds":0.5,"data":""}],"presets":[{"name":"Gabber hoover","calls":[".s(\"supersaw\")",".penv(slider(-12, -24, 24))",".lpf(slider(2500, 100, 8000))",".attack(slider(0.02, 0, 1))",".decay(slider(0.4, 0, 2))",".sustain(slider(0.6, 0, 1))",".release(slider(0.3, 0, 2))",".distort(slider(0.6, 0, 5))",".phaser(slider(0.7, 0, 8))"],"pitch":48},{"name":"Gabber stab","calls":[".s(\"supersaw\")",".lpf(slider(3000, 100, 8000))",".decay(slider(0.2, 0, 2))",".sustain(slider(0, 0, 1))",".room(slider(0.3, 0, 1))",".distort(slider(0.8, 0, 5))"],"pitch":60}],"snippets":[{"name":"gabber-beat","code":"drums: stack(\n  s(\"gabber_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"gabber_hat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n  s(\"gabber_snare\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   x ~ x x\"),\n)"},{"name":"gabber-stabs","code":"drums: stack(\n  s(\"gabber_stab\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ x ~   ~ x ~ ~\"),\n)"}]}