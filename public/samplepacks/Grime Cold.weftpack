{"weftpack":1,"id":"grime","name":"Grime Cold","by":"Weft Loom","about":"Grime at 140: a cold square bass, a snare that cracks, a kick, a clap and clicks, a pizzicato stab and a bell. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"grime_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"grime_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"grime_clap","file":"clap.wav","type":"audio/wav","seconds":0.45,"data":""},{"name":"grime_click","file":"click.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"grime_hat","file":"hat.wav","type":"audio/wav","seconds":0.192,"data":""},{"name":"grime_square","file":"square.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"grime_pizz","file":"pizz.wav","type":"audio/wav","seconds":0.7,"data":""},{"name":"grime_bell","file":"bell.wav","type":"audio/wav","seconds":1.4,"data":""}],"presets":[{"name":"Grime square","calls":[".s(\"square\")",".lpf(slider(900, 100, 8000))",".lpq(slider(3, 0, 30))",".decay(slider(0.3, 0, 2))",".sustain(slider(0.3, 0, 1))",".release(slider(0.05, 0, 2))"],"pitch":31},{"name":"Grime eski","calls":[".s(\"square\")",".penv(slider(-12, -24, 24))",".decay(slider(0.25, 0, 2))",".sustain(slider(0, 0, 1))",".release(slider(0.05, 0, 2))",".crush(slider(8, 1, 16))"],"pitch":43},{"name":"Grime strings","calls":[".s(\"gm_pizzicato_strings\")",".room(slider(0.3, 0, 1))"],"pitch":67}],"snippets":[{"name":"grime-beat","code":"drums: stack(\n  s(\"grime_kick\").struct(\"x ~ ~ ~   ~ ~ ~ x   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"grime_snare\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"grime_clap\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"grime_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n  s(\"grime_click\").struct(\"~ ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   ~ x ~ x\"),\n)"},{"name":"grime-bass","code":"drums: stack(\n  s(\"grime_square\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ x ~   x ~ ~ ~\"),\n  s(\"grime_bell\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~\"),\n)"},{"name":"grime-pizz","code":"pizz: note(`\n  g4 ~ g4 a#4   ~ d5 ~ g4   f4 ~ f4 a4   ~ c5 ~ f4\n`)\n  .s(\"gm_pizzicato_strings\")\n  .room(slider(0.3, 0, 1))"}]}