{"weftpack":1,"id":"amapiano","name":"Amapiano","by":"Weft Loom","about":"Amapiano at 113: log drums on three notes, a shaker that swings, a soft kick, a rim and a clap, and a jazzy piano chord. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"amapiano_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"amapiano_log","file":"log.wav","type":"audio/wav","seconds":0.8,"data":""},{"name":"amapiano_loglow","file":"loglow.wav","type":"audio/wav","seconds":0.8,"data":""},{"name":"amapiano_loghigh","file":"loghigh.wav","type":"audio/wav","seconds":0.8,"data":""},{"name":"amapiano_shaker","file":"shaker.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"amapiano_rim","file":"rim.wav","type":"audio/wav","seconds":0.023,"data":""},{"name":"amapiano_clap","file":"clap.wav","type":"audio/wav","seconds":0.85,"data":""},{"name":"amapiano_piano","file":"piano.wav","type":"audio/wav","seconds":2.7,"data":""}],"presets":[{"name":"Amapiano log","calls":[".s(\"sine\")",".penv(slider(5, -24, 24))",".lpf(slider(1200, 100, 8000))",".decay(slider(0.3, 0, 2))",".sustain(slider(0, 0, 1))",".distort(slider(1.2, 0, 5))"],"pitch":41},{"name":"Amapiano keys","calls":[".s(\"gm_epiano1\")",".lpf(slider(3000, 100, 8000))",".room(slider(0.4, 0, 1))",".chorus(slider(0.4, 0, 1))"],"pitch":60},{"name":"Amapiano pad","calls":[".s(\"triangle\")",".attack(slider(0.4, 0, 1))",".release(slider(1.2, 0, 2))",".room(slider(0.6, 0, 1))",".chorus(slider(0.6, 0, 1))"],"pitch":60}],"snippets":[{"name":"amapiano-beat","code":"drums: stack(\n  s(\"amapiano_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"amapiano_shaker\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"amapiano_rim\").struct(\"~ ~ ~ x   ~ ~ x ~   ~ ~ ~ x   ~ ~ x ~\"),\n  s(\"amapiano_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n)\n  .swingBy(0.2, 8)"},{"name":"amapiano-logs","code":"drums: stack(\n  s(\"amapiano_log\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"amapiano_loglow\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ x ~ ~\"),\n  s(\"amapiano_loghigh\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ x   ~ ~ ~ x\"),\n)"},{"name":"amapiano-logline","code":"logs: note(`\n  f2 ~ ~ f2   ~ ~ a#2 ~   ~ ~ c3 ~   ~ a#1 ~ ~\n`)\n  .s(\"sine\")\n  .penv(slider(5, -24, 24))\n  .lpf(slider(1200, 100, 8000))\n  .decay(slider(0.3, 0, 2))\n  .sustain(slider(0, 0, 1))\n  .distort(slider(1.2, 0, 5))"}]}