{"weftpack":1,"id":"hyper","name":"Hyperpop Candy","by":"Weft Loom","about":"Hyperpop at 160: a kick pushed into the red, a crushed snare, hats, two sung chops up high, a supersaw stab, a laser and a glitch. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"hyper_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"hyper_snare","file":"snare.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"hyper_hat","file":"hat.wav","type":"audio/wav","seconds":0.147,"data":""},{"name":"hyper_voice","file":"voice.wav","type":"audio/wav","seconds":0.3,"data":""},{"name":"hyper_voice2","file":"voice2.wav","type":"audio/wav","seconds":0.25,"data":""},{"name":"hyper_stab","file":"stab.wav","type":"audio/wav","seconds":0.8,"data":""},{"name":"hyper_laser","file":"laser.wav","type":"audio/wav","seconds":0.75,"data":""},{"name":"hyper_glitch","file":"glitch.wav","type":"audio/wav","seconds":0.4,"data":""}],"presets":[{"name":"Hyper lead","calls":[".s(\"supersaw\")",".vib(slider(7, 0, 12))",".vibmod(slider(0.3, 0, 2))",".lpf(slider(6000, 100, 8000))",".attack(slider(0.01, 0, 1))",".sustain(slider(0.7, 0, 1))",".release(slider(0.1, 0, 2))",".distort(slider(0.8, 0, 5))",".crush(slider(8, 1, 16))"],"pitch":76},{"name":"Hyper 808","calls":[".s(\"sine\")",".penv(slider(12, -24, 24))",".attack(slider(0.01, 0, 1))",".decay(slider(0.7, 0, 2))",".sustain(slider(0.3, 0, 1))",".distort(slider(2.5, 0, 5))",".gain(slider(0.45, 0, 1.5))"],"pitch":33},{"name":"Hyper bell","calls":[".s(\"sine\")",".fm(slider(4, 0, 8))",".fmh(slider(3.5, 0.5, 8))",".fmdecay(slider(0.2, 0, 2))",".decay(slider(0.4, 0, 2))",".sustain(slider(0, 0, 1))",".delay(slider(0.3, 0, 1))",".room(slider(0.4, 0, 1))"],"pitch":84}],"snippets":[{"name":"hyper-beat","code":"drums: stack(\n  s(\"hyper_kick\").struct(\"x ~ ~ ~   ~ ~ x ~   ~ ~ x ~   ~ ~ ~ ~\"),\n  s(\"hyper_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"hyper_hat\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"hyper_glitch\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ x\"),\n)\n  .lastOf(4, ply(2))"},{"name":"hyper-chops","code":"drums: stack(\n  s(\"hyper_voice\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"hyper_voice2\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ x ~ ~   ~ ~ x ~\"),\n)"},{"name":"hyper-stabs","code":"drums: stack(\n  s(\"hyper_stab\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"hyper_laser\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n)"}]}