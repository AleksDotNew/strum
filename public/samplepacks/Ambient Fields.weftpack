{"weftpack":1,"id":"fields","name":"Ambient Fields","by":"Weft Loom","about":"Ambient at 70: two drones to lie under a song, wind, a bell, a shimmer and a soft kick. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"fields_drone","file":"drone.wav","type":"audio/wav","seconds":8,"data":""},{"name":"fields_drone2","file":"drone2.wav","type":"audio/wav","seconds":8,"data":""},{"name":"fields_wind","file":"wind.wav","type":"audio/wav","seconds":5.999,"data":""},{"name":"fields_bell","file":"bell.wav","type":"audio/wav","seconds":4.147,"data":""},{"name":"fields_shimmer","file":"shimmer.wav","type":"audio/wav","seconds":5.083,"data":""},{"name":"fields_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""}],"presets":[{"name":"Fields pad","calls":[".s(\"triangle\")",".attack(slider(1.5, 0, 1))",".release(slider(2, 0, 2))",".room(slider(0.8, 0, 1))",".roomsize(slider(9, 0, 10))",".chorus(slider(0.6, 0, 1))"],"pitch":57},{"name":"Fields bell","calls":[".s(\"sine\")",".fm(slider(2, 0, 8))",".fmh(slider(3.5, 0.5, 8))",".fmdecay(slider(0.6, 0, 2))",".decay(slider(1.5, 0, 2))",".sustain(slider(0, 0, 1))",".release(slider(1.2, 0, 2))",".room(slider(0.7, 0, 1))",".roomsize(slider(8, 0, 10))"],"pitch":79},{"name":"Fields glass","calls":[".s(\"triangle\")",".fm(slider(1, 0, 8))",".fmh(slider(5, 0.5, 8))",".attack(slider(0.3, 0, 1))",".release(slider(1.6, 0, 2))",".delay(slider(0.4, 0, 1))",".room(slider(0.7, 0, 1))"],"pitch":72}],"snippets":[{"name":"fields-drone","code":"drums: stack(\n  s(\"fields_drone\").struct(\"x ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n)\n  .slow(2)"},{"name":"fields-bells","code":"drums: stack(\n  s(\"fields_bell\").struct(\"~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ x ~ ~\"),\n)\n  .delay(0.5).delayfeedback(0.6).room(0.6)"},{"name":"fields-air","code":".room(0.9).roomsize(10).delay(0.5).delayfeedback(0.7)"}]}