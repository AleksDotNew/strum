{"weftpack":1,"id":"jazz","name":"Jazz Brushes","by":"Weft Loom","about":"Jazz at 120 with brushes: a sweep and a tap on the snare, a ride that swings, a soft kick, the hat foot, an upright bass, and a piano, a Rhodes and vibes to play. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"jazz_sweep","file":"sweep.wav","type":"audio/wav","seconds":0.899,"data":""},{"name":"jazz_tap","file":"tap.wav","type":"audio/wav","seconds":0.4,"data":""},{"name":"jazz_ride","file":"ride.wav","type":"audio/wav","seconds":1.2,"data":""},{"name":"jazz_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"jazz_foot","file":"foot.wav","type":"audio/wav","seconds":0.158,"data":""},{"name":"jazz_bass","file":"bass.wav","type":"audio/wav","seconds":1.2,"data":""}],"presets":[{"name":"Jazz piano","calls":[".s(\"piano\")",".room(slider(0.3, 0, 1))",".roomsize(slider(3, 0, 10))"],"pitch":60},{"name":"Jazz rhodes","calls":[".s(\"gm_epiano1\")",".lpf(slider(3500, 100, 8000))",".room(slider(0.3, 0, 1))",".chorus(slider(0.3, 0, 1))"],"pitch":60},{"name":"Jazz vibes","calls":[".s(\"gm_vibraphone\")",".room(slider(0.4, 0, 1))",".roomsize(slider(4, 0, 10))"],"pitch":72},{"name":"Jazz upright","calls":[".s(\"gm_acoustic_bass\")",".decay(slider(0.6, 0, 2))",".sustain(slider(0.4, 0, 1))",".release(slider(0.2, 0, 2))"],"pitch":36}],"snippets":[{"name":"jazz-swing","code":"drums: stack(\n  s(\"jazz_ride\").struct(\"x ~ ~ ~   x ~ x ~   x ~ ~ ~   x ~ x ~\"),\n  s(\"jazz_foot\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"jazz_tap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"jazz_sweep\").struct(\"x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"jazz_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n)\n  .swingBy(0.33, 4)"},{"name":"jazz-walk","code":"bass: note(`\n  c2 e2 g2 a2   d2 f2 a2 c3   g1 b1 d2 f2   c2 g1 a1 b1\n`).slow(4)\n  .s(\"gm_acoustic_bass\")\n  .decay(slider(0.6, 0, 2))\n  .sustain(slider(0.4, 0, 1))\n  .release(slider(0.2, 0, 2))"}]}