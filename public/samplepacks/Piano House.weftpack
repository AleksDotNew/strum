{"weftpack":1,"id":"house","name":"Piano House","by":"Weft Loom","about":"Piano house at 124: a kick, a clap, open hats, a shaker and a tambourine, and two piano chords to stab. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"house_kick","file":"kick.wav","type":"audio/wav","seconds":0.6,"data":""},{"name":"house_clap","file":"clap.wav","type":"audio/wav","seconds":0.85,"data":""},{"name":"house_hat","file":"hat.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"house_openhat","file":"openhat.wav","type":"audio/wav","seconds":0.5,"data":""},{"name":"house_shaker","file":"shaker.wav","type":"audio/wav","seconds":0.15,"data":""},{"name":"house_tambourine","file":"tambourine.wav","type":"audio/wav","seconds":0.35,"data":""},{"name":"house_piano","file":"piano.wav","type":"audio/wav","seconds":2.598,"data":""},{"name":"house_piano2","file":"piano2.wav","type":"audio/wav","seconds":2.6,"data":""}],"presets":[{"name":"House piano","calls":[".s(\"piano\")",".hpf(slider(200, 20, 4000))",".room(slider(0.3, 0, 1))",".roomsize(slider(4, 0, 10))"],"pitch":60},{"name":"House bass","calls":[".s(\"sawtooth\")",".lpf(slider(500, 100, 8000))",".lpq(slider(5, 0, 30))",".lpenv(slider(2, 0, 8))",".lpdecay(slider(0.12, 0, 1))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.3, 0, 1))",".release(slider(0.05, 0, 2))"],"pitch":36},{"name":"House strings","calls":[".s(\"gm_string_ensemble_1\")",".attack(slider(0.3, 0, 1))",".release(slider(1, 0, 2))",".room(slider(0.5, 0, 1))"],"pitch":60}],"snippets":[{"name":"house-beat","code":"drums: stack(\n  s(\"house_kick\").struct(\"x ~ ~ ~   x ~ ~ ~   x ~ ~ ~   x ~ ~ ~\"),\n  s(\"house_clap\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"house_openhat\").struct(\"~ ~ x ~   ~ ~ x ~   ~ ~ x ~   ~ ~ x ~\"),\n  s(\"house_shaker\").struct(\"x x x x   x x x x   x x x x   x x x x\"),\n  s(\"house_tambourine\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ x\"),\n)"},{"name":"house-stabs","code":"drums: stack(\n  s(\"house_piano\").struct(\"x ~ ~ x   ~ ~ x ~   ~ ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"house_piano2\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ x   ~ ~ x ~\"),\n)"},{"name":"house-chords","code":"chords: note(`\n  [a3,c4,e4,g4] ~ ~ [a3,c4,e4,g4]   ~ ~ [a3,c4,e4,g4] ~   [f3,a3,c4,e4] ~ ~ [f3,a3,c4,e4]   ~ ~ [g3,b3,d4] ~\n`)\n  .s(\"piano\")\n  .hpf(slider(200, 20, 4000))\n  .room(slider(0.3, 0, 1))\n  .roomsize(slider(4, 0, 10))"}]}