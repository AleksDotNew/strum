{"weftpack":1,"id":"chip","name":"Chip Arcade","by":"Weft Loom","about":"Chiptune at 150: drums made of noise and square waves, a coin, a laser and a jump, and square and triangle sounds for tunes. Every sound in it is made from sums, not taken from a recording.","sounds":[{"name":"chip_kick","file":"kick.wav","type":"audio/wav","seconds":0.2,"data":""},{"name":"chip_snare","file":"snare.wav","type":"audio/wav","seconds":0.165,"data":""},{"name":"chip_hat","file":"hat.wav","type":"audio/wav","seconds":0.031,"data":""},{"name":"chip_coin","file":"coin.wav","type":"audio/wav","seconds":0.35,"data":""},{"name":"chip_laser","file":"laser.wav","type":"audio/wav","seconds":0.3,"data":""},{"name":"chip_jump","file":"jump.wav","type":"audio/wav","seconds":0.3,"data":""}],"presets":[{"name":"Chip lead","calls":[".s(\"square\")",".vib(slider(6, 0, 12))",".vibmod(slider(0.1, 0, 2))",".attack(slider(0.01, 0, 1))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.6, 0, 1))",".release(slider(0.05, 0, 2))",".crush(slider(6, 1, 16))"],"pitch":72},{"name":"Chip bass","calls":[".s(\"triangle\")",".attack(slider(0.01, 0, 1))",".decay(slider(0.2, 0, 2))",".sustain(slider(0.7, 0, 1))",".release(slider(0.05, 0, 2))",".crush(slider(5, 1, 16))"],"pitch":36},{"name":"Chip arp","calls":[".s(\"square\")",".decay(slider(0.08, 0, 2))",".sustain(slider(0, 0, 1))",".release(slider(0.02, 0, 2))",".delay(slider(0.2, 0, 1))",".crush(slider(6, 1, 16))"],"pitch":72}],"snippets":[{"name":"chip-beat","code":"drums: stack(\n  s(\"chip_kick\").struct(\"x ~ ~ ~   ~ ~ x ~   x ~ ~ ~   ~ ~ ~ ~\"),\n  s(\"chip_snare\").struct(\"~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~\"),\n  s(\"chip_hat\").struct(\"x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~\"),\n)"},{"name":"chip-arp","code":"arp: note(`\n  c5 e5 g5 c6   g5 e5 c5 e5   a4 c5 e5 a5   e5 c5 a4 c5\n`)\n  .s(\"square\")\n  .decay(slider(0.08, 0, 2))\n  .sustain(slider(0, 0, 1))\n  .release(slider(0.02, 0, 2))\n  .delay(slider(0.2, 0, 1))\n  .crush(slider(6, 1, 16))"},{"name":"chip-coins","code":"drums: stack(\n  s(\"chip_coin\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~\"),\n  s(\"chip_jump\").struct(\"~ ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~\"),\n)"}]}