    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "acorn": "^8.19.0",
    "idb": "^8.0.4",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
