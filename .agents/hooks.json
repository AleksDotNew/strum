{
  "strum-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 scripts/session_start.py",
        "timeout": 10
      }
    ]
  },
  "strum-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
